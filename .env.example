# ==============================================
# Environment Variables
# ==============================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/myapp

# Dual7 release migration range (npm run db:migrate against a BYO database)
# Inclusive numeric prefixes from lib/migrations/*.sql (e.g. 0005_*.sql → 5).
# Set automatically on Create Release; override as needed.
# MIGRATION_START=1
# MIGRATION_END=1

# NextAuth (if using authentication)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
